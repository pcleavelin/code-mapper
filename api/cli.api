convert::pub struct StepIndex(usize);
convert::pub struct Under(i64);
convert::pub struct Count(usize);
failure::pub struct StepPlace { pub tour: TourName, pub index: StepIndex, }
failure::pub struct Candidate { pub name: Output, pub label: Output, }
failure::pub enum Failure { Map(MapError), LinkedFrom { tour: TourName, steps: Vec<StepPlace>, }, NoSuchTour(TextFragment), NoSuchStep, NoSuchFile(RelativePath), NoSuchSymbol(SymbolName), SymbolClash { query: SymbolName, candidates: Vec<Candidate>, }, LineRange, NoPlaceUnder { under: Under, steps: Count, }, NoLink(StepIndex), NoLinkTarget, Regex(regex::Error), ServersInBackground, NoRepository, NoMapAt { directory: RelativePath, revision: Revision, program: Program, }, Parse(ParseError), Load(MapLoadError), Save(MapSaveError), Stale { steps: Count, links: Count, }, }
pub struct Argument(String);
pub fn new(text: &str) -> Self
pub fn as_str(&self) -> &str
pub struct CommandLine(String);
pub fn new(line: &str) -> Self
pub fn as_str(&self) -> &str
pub fn arguments(&self) -> Vec<Argument>
pub enum Channel { Stdout, Stderr, }
pub struct ParseFailure(clap::Error);
pub fn text(&self) -> Output
pub fn channel(&self) -> Channel
pub struct Invocation { feature: Feature, request: Request, }
pub fn parse(arguments: &[Argument]) -> Result<Self, ParseFailure>
pub fn feature(&self) -> Feature
pub fn help() -> Output
pub fn notice(notice: &ServerNotice) -> Output
pub fn start_error(error: &StartError) -> Output
pub fn symbol_label(index: &Index, symbol: SymbolId) -> Output
pub fn map_failure(map: &Map, error: MapError) -> Failure
pub fn exec( index: &mut Index, map: &mut Map, invocation: Invocation, author: Author, servers: Option<&mut Servers>, output: &mut Output, ) -> Result<Option<Changed>, Failure>
output::pub struct Output(String);
output::pub fn new() -> Self
output::pub fn as_str(&self) -> &str
output::pub fn is_empty(&self) -> bool
output::pub fn extend(&mut self, other: &Self)
