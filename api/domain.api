text::pub const fn value(self) -> u32
text::pub struct TextHash(u64);
text::pub const fn new(value: u64) -> Self
text::pub const fn value(self) -> u64
text::pub fn of(bytes: &[u8]) -> Self
text::pub fn of_bytes(bytes: impl IntoIterator<Item = u8>) -> Self
text::pub fn of_lines(lines: &[SourceLine]) -> Self
text::pub struct SourceLine(String);
text::pub fn new(text: &str) -> Self
text::pub fn as_str(&self) -> &str
text::pub fn trimmed(&self) -> &str
text::pub struct FileText { lines: Vec<SourceLine>, whole: TextHash, }
text::pub fn line(&self, line: Line) -> Option<&SourceLine>
text::pub fn lines(&self, span: Span) -> Option<&[SourceLine]>
text::pub fn all(&self) -> &[SourceLine]
text::pub fn hash(&self, span: Span) -> Option<TextHash>
text::pub fn count(&self) -> LineCount
text::pub fn span(&self) -> Option<Span>
text::pub fn whole_hash(&self) -> TextHash
text::pub struct Revision(String);
text::pub fn new(revision: &str) -> Self
text::pub fn as_str(&self) -> &str
text::pub struct RelativePath(String);
text::pub fn new(path: &str) -> Self
text::pub fn as_str(&self) -> &str
text::pub fn stem(&self) -> &str
text::pub fn package(&self) -> &str
text::pub fn directory(&self) -> Option<&str>
text::pub fn extension(&self) -> Option<&str>
text::pub fn ends_with(&self, suffix: &str) -> bool
